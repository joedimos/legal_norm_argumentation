# One-time setup for the explicitly strict French/U.S. IP profile.
# Copy to untracked deployment.rc.env and inject actual secrets with your platform.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
VLE_BUILD_REVISION=REPLACE_WITH_FULL_DEPLOYED_GIT_SHA
VLE_API_KEYS_JSON=[]
VLE_METRICS_BEARER_TOKEN=REPLACE_WITH_STRONG_RANDOM_METRICS_TOKEN
VLE_MODEL_PROVIDER=vllm
VLE_MODEL_NAME=REPLACE_WITH_APPROVED_MODEL
VLE_MODEL_REVISION=REPLACE_WITH_VERIFIED_MODEL_REVISION
VLE_MODEL_ENDPOINT=
VLE_MODEL_API_KEY=
VLE_INFERENCE_ENABLED=true
VLE_LEGIFRANCE_PISTE_CLIENT_ID=
VLE_LEGIFRANCE_PISTE_CLIENT_SECRET=
VLE_COURTLISTENER_API_TOKEN=
VLE_EVIDENCE_DIR=./deployment-evidence
VLE_REVIEWER_REGISTRY_PATH=/evidence/reviewer-registry.json
VLE_REVIEWER_REGISTRY_SHA256=
VLE_RELEASE_EVIDENCE_PATH=/evidence/release-v2.json
VLE_RELEASE_EVIDENCE_SHA256=
VLE_RELEASE_PROFILE=ip-supervised-v1
VLE_RELEASE_ENFORCEMENT=strict
VLE_RELEASE_SOURCE_MAX_AGE_SECONDS=172800
VLE_RELEASE_MAX_FALSE_COMPLIANCE_RATE=0

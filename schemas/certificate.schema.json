{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "vle-certificate/v1"
    },
    "type": {
      "enum": [
        "violation",
        "compliant_within_bound",
        "conflict",
        "unknown"
      ]
    },
    "query": {
      "type": "object",
      "required": [
        "property",
        "horizon",
        "assumptions",
        "observations",
        "binding"
      ]
    },
    "query_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence": {
      "type": "object"
    },
    "review_status": {
      "const": "unreviewed"
    },
    "decision_authorized": {
      "const": false
    },
    "legal_certification": {
      "const": false
    }
  },
  "required": [
    "schema",
    "type",
    "query",
    "query_sha256",
    "evidence",
    "review_status",
    "decision_authorized",
    "legal_certification"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "type": "object",
            "required": [
              "bound",
              "limit"
            ],
            "properties": {
              "bound": {
                "type": "string"
              },
              "limit": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}

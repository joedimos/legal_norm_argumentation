{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "entities",
    "predicates",
    "queries",
    "horizon"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "vle-pyreason-graph/v1"
    },
    "kind": {
      "enum": [
        "synthetic",
        "source_derived"
      ]
    },
    "review_status": {
      "const": "unreviewed"
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "predicates": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "additionalProperties": {
        "enum": [
          1,
          2
        ]
      }
    },
    "horizon": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "bindings": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "facts": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "atom",
          "interval",
          "start",
          "end"
        ],
        "additionalProperties": false,
        "properties": {
          "atom": {
            "type": "object",
            "required": [
              "predicate",
              "arguments"
            ],
            "additionalProperties": false,
            "properties": {
              "predicate": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "arguments": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          },
          "interval": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "id",
          "head",
          "body",
          "interval",
          "delay"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "head": {
            "type": "object",
            "required": [
              "predicate",
              "arguments"
            ],
            "additionalProperties": false,
            "properties": {
              "predicate": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "arguments": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          },
          "body": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "atom",
                "interval"
              ],
              "additionalProperties": false,
              "properties": {
                "atom": {
                  "type": "object",
                  "required": [
                    "predicate",
                    "arguments"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "predicate": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "arguments": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 2,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    }
                  }
                },
                "interval": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          },
          "interval": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "delay": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          }
        }
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "id",
          "atom",
          "at"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "atom": {
            "type": "object",
            "required": [
              "predicate",
              "arguments"
            ],
            "additionalProperties": false,
            "properties": {
              "predicate": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "arguments": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          },
          "at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          }
        }
      }
    }
  }
}

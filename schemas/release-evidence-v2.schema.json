    "expires_at": {
      "minLength": 1,
      "type": "string"
    },
    "model_revision": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "vle-release-evidence/v2"
    },
    "scope": {
      "const": "fr-us-ip-supervised/v1"
    }

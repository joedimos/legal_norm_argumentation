            }
          },
          "required": [
            "filename",
            "sha256"
          ],
          "type": "object"
        },
        "ip_sources": {
          "additionalProperties": false,
          "properties": {
            "filename": {
              "pattern": "^[a-zA-Z0-9_-]{1,80}\\.json$",
              "type": "string"

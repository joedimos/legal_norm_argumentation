            "filename": {
              "pattern": "^[a-zA-Z0-9_-]{1,80}\\.json$",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "filename",
            "sha256"
          ],
          "type": "object"
        },
        "review_protocol": {
          "additionalProperties": false,
          "properties": {
            "filename": {
              "pattern": "^[a-zA-Z0-9_-]{1,80}\\.json$",

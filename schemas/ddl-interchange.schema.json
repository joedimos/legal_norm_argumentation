{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "vle-ddl-interchange/v1"
    },
    "status": {
      "const": "unreviewed"
    },
    "operation": {
      "enum": [
        "export",
        "import",
        "segment",
        "refine",
        "metrics"
      ]
    },
    "lossy_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "review_status": {
      "const": "unreviewed"
    },
    "decision_authorized": {
      "const": false
    },
    "legal_certification": {
      "const": false
    },
    "text": {
      "type": "string"
    },
    "document": {
      "type": "object"
    },
    "metadata_sidecar": {
      "type": "object"
    },
    "typed_norms": {
      "type": "array"
    },
    "interpretation_set": {
      "type": [
        "object",
        "null"
      ]
    },
    "sidecar_restoration_only": {
      "const": true
    },
    "snippets": {
      "type": "array"
    },
    "proposal": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "status",
    "operation",
    "lossy_fields",
    "request_sha256",
    "review_status",
    "decision_authorized",
    "legal_certification"
  ],
  "additionalProperties": false
}

# Copy to an untracked deployment.env; inject real secrets through your deployment platform.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
VLE_BUILD_REVISION=REPLACE_WITH_FULL_DEPLOYED_GIT_SHA
VLE_API_KEYS_JSON=[]
VLE_METRICS_BEARER_TOKEN=REPLACE_WITH_STRONG_RANDOM_METRICS_TOKEN
VLE_LEGIFRANCE_ENABLED=true
VLE_LEGIFRANCE_SOURCE=piste
VLE_LEGIFRANCE_PISTE_ENVIRONMENT=production
VLE_LEGIFRANCE_PISTE_CLIENT_ID=
VLE_LEGIFRANCE_PISTE_CLIENT_SECRET=
VLE_INFERENCE_ENABLED=false
# Install .[pyreason] or use docker-compose.pyreason.yml for the native image/profile.
VLE_PYREASON_ENABLED=false
VLE_MODEL_PROVIDER=vllm
VLE_MODEL_NAME=
VLE_MODEL_ENDPOINT=
VLE_MODEL_REVISION=
VLE_MODEL_API_KEY=
VLE_EVIDENCE_DIR=./deployment-evidence
VLE_REVIEWER_REGISTRY_PATH=
VLE_REVIEWER_REGISTRY_SHA256=
VLE_RELEASE_EVIDENCE_PATH=
VLE_RELEASE_EVIDENCE_SHA256=

# External release/case evidence is advisory; use strict to require it.
VLE_RELEASE_ENFORCEMENT=reviewed

# Optional native backend qualification; never substitute synthetic test approvals.
VLE_PYREASON_WORKER_MODE=isolated
VLE_PYREASON_WARMUP=false
VLE_PYREASON_WARMUP_TIMEOUT_SECONDS=300
VLE_PYREASON_RELEASE_PATH=
VLE_PYREASON_RELEASE_SHA256=

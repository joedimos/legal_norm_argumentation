# Copy to an untracked deployment.env; inject real secrets through your deployment platform.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
VLE_BUILD_REVISION=REPLACE_WITH_FULL_DEPLOYED_GIT_SHA
VLE_API_KEYS_JSON=[]
VLE_METRICS_BEARER_TOKEN=REPLACE_WITH_STRONG_RANDOM_METRICS_TOKEN
VLE_LEGIFRANCE_ENABLED=true
VLE_LEGIFRANCE_SOURCE=piste
VLE_LEGIFRANCE_PISTE_ENVIRONMENT=production
VLE_LEGIFRANCE_PISTE_CLIENT_ID=

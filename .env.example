# Never commit real secrets. Generate independent 32+ character values and inject them with a secret manager.
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
VLE_API_KEYS_JSON=[{"token":"replace_with_operator_token_at_least_32_chars","subject":"operator-service","roles":["operator","reader"]},{"token":"replace_with_reviewer_token_at_least_32_chars","subject":"human-reviewer","roles":["reviewer","reader","auditor"]}]
VLE_METRICS_BEARER_TOKEN=replace_with_metrics_token_at_least_32_chars
VLE_CORS_ORIGINS_CSV=
VLE_OTLP_ENDPOINT=
VLE_OTLP_HEADERS=
VLE_LEGIFRANCE_ENABLED=true
# auto = use official PISTE API when credentials are present, otherwise bounded public HTML fallback.
VLE_LEGIFRANCE_SOURCE=auto
VLE_LEGIFRANCE_PISTE_ENVIRONMENT=production
VLE_LEGIFRANCE_PISTE_CLIENT_ID=
VLE_LEGIFRANCE_PISTE_CLIENT_SECRET=
VLE_LEGIFRANCE_TIMEOUT_SECONDS=12
VLE_LEGIFRANCE_REQUEST_DELAY_SECONDS=0.2
VLE_LEGIFRANCE_MAX_ARTICLES_PER_RUN=50
VLE_LEGIFRANCE_MAX_FULL_SYNC_ARTICLES=2500

# Automatic IP acquisition (starts with Docker Compose; credentials are one-time setup).
VLE_AUTO_IMPORT_ENABLED=true
VLE_COURTLISTENER_ENABLED=true
VLE_COURTLISTENER_API_TOKEN=
# CourtListener -> Profile -> API token. Never put this token in browser JavaScript.
VLE_COURTLISTENER_REQUEST_DELAY_SECONDS=13
VLE_IMPORT_BATCH_SIZE=3
VLE_IMPORT_POLL_SECONDS=15
VLE_IMPORT_REFRESH_SECONDS=86400
VLE_IMPORT_RECONCILE_SECONDS=604800
VLE_IMPORT_RECENT_DAYS=90
VLE_IMPORT_START_DATE=1700-01-01
VLE_IMPORT_MAX_RUN_SECONDS=120
VLE_IMPORT_LEASE_SECONDS=180
